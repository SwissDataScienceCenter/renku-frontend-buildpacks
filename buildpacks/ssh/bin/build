#!/usr/bin/env bash
set -eo pipefail

echo -e "=== ✨ \033[1mRenku SSH buildpack\033[0m ==="

echo "  Build configuration:"
echo -e "    \$BP_RENKU_FRONTENDS\t${BP_RENKU_FRONTENDS}\tThe frontends to install"

unset "$LD_LIBRARY_PATH"

layers_dir="${CNB_LAYERS_DIR}"
buildpack_dir="${CNB_BUILDPACK_DIR}"
ssh_layer_dir="${layers_dir}"/ssh
ssh_bin_dir="${ssh_layer_dir}"/bin
ssh_www_dir="${ssh_layer_dir}"/www
mkdir -p "${ssh_bin_dir}" "${ssh_www_dir}"

DROPBEAR_VERSION="2026.94"
DROPBEAR_URL="https://github.com/mkj/dropbear/archive/refs/tags/DROPBEAR_${DROPBEAR_VERSION}.tar.gz"
OPENSSH_URL="https://github.com/openssh/openssh-portable/archive/refs/tags/V_10_0_P2.tar.gz"
DARKHTTPD_VERSION="1.17"
DARKHTTPD_URL="https://github.com/emikulic/darkhttpd/archive/refs/tags/v${DARKHTTPD_VERSION}.tar.gz"

build_tmp="$(mktemp -d)"
trap 'rm -rf "${build_tmp}"' EXIT

# dropbear: no upstream prebuilt binaries, compile from source (build image has build-essential)
# scp: legacy scp protocol (client `scp -O`) execs a remote scp binary; dropbear ships one
# localoptions.h: dropbear has no native sftp, it execs SFTPSERVER_PATH; point it at the
# sftp-server binary built below (no configure flag for this, compile-time define only).
curl -sL -o "${build_tmp}/dropbear.tar.gz" "${DROPBEAR_URL}"
tar -xzf "${build_tmp}/dropbear.tar.gz" -C "${build_tmp}"
dropbear_src="${build_tmp}/dropbear-DROPBEAR_${DROPBEAR_VERSION}/src"
cat >"${build_tmp}/dropbear-DROPBEAR_${DROPBEAR_VERSION}/localoptions.h" <<EOL
#define SFTPSERVER_PATH "${ssh_bin_dir}/sftp-server"
EOL
# dropbear clears the environment and resets PATH to its compiled-in default for every
# session; keep the launcher-provided PATH instead with dropbear -e (pass env through)
# PATH is already the full CNB launch PATH, so only fall back to the default when unset
sed -i \
  -e 's|addnewvar("PATH", DEFAULT_ROOT_PATH);|if (!getenv("PATH")) addnewvar("PATH", DEFAULT_ROOT_PATH);|' \
  -e 's|addnewvar("PATH", DEFAULT_PATH);|if (!getenv("PATH")) addnewvar("PATH", DEFAULT_PATH);|' \
  "${dropbear_src}/svr-chansession.c"
[[ "$(grep -c 'if (!getenv("PATH")) addnewvar("PATH"' "${dropbear_src}/svr-chansession.c")" == "2" ]] || {
  echo "failed to patch dropbear session PATH handling" >&2
  exit 1
}
(
  cd "${build_tmp}/dropbear-DROPBEAR_${DROPBEAR_VERSION}" &&
  ./configure --disable-zlib >/dev/null &&
  make -j"$(nproc)" PROGRAMS="dropbear dropbearkey scp" >/dev/null
)
cp "${build_tmp}/dropbear-DROPBEAR_${DROPBEAR_VERSION}/dropbear" "${ssh_bin_dir}/"
cp "${build_tmp}/dropbear-DROPBEAR_${DROPBEAR_VERSION}/dropbearkey" "${ssh_bin_dir}/"
cp "${build_tmp}/dropbear-DROPBEAR_${DROPBEAR_VERSION}/scp" "${ssh_bin_dir}/"

# sftp-server: standalone sftp server binary from openssh (the de facto standard one
# dropbear expects); built without openssl/zlib so it links libc only at runtime
curl -sL -o "${build_tmp}/openssh.tar.gz" "${OPENSSH_URL}"
tar -xzf "${build_tmp}/openssh.tar.gz" -C "${build_tmp}"
(
  cd "${build_tmp}/openssh-portable-V_10_0_P2" &&
  ./configure --without-openssl --without-zlib CFLAGS="-O2 -w" >/dev/null &&
  make sftp-server >/dev/null
)
cp "${build_tmp}/openssh-portable-V_10_0_P2/sftp-server" "${ssh_bin_dir}/"

# darkhttpd: single-file static web server for the placeholder page
curl -sL -o "${build_tmp}/darkhttpd.tar.gz" "${DARKHTTPD_URL}"
tar -xzf "${build_tmp}/darkhttpd.tar.gz" -C "${build_tmp}"
cc -O2 -o "${ssh_bin_dir}/darkhttpd" "${build_tmp}/darkhttpd-${DARKHTTPD_VERSION}/darkhttpd.c"

chmod 755 "${ssh_bin_dir}"/dropbear "${ssh_bin_dir}"/dropbearkey "${ssh_bin_dir}"/scp "${ssh_bin_dir}"/sftp-server "${ssh_bin_dir}"/darkhttpd
cp "${buildpack_dir}/bin/ssh-entrypoint.sh" "${ssh_bin_dir}/ssh-entrypoint.sh"
chmod 755 "${ssh_bin_dir}"/ssh-entrypoint.sh
cp "${buildpack_dir}/bin/ssh-session.sh" "${ssh_bin_dir}/ssh-session.sh"
chmod 755 "${ssh_bin_dir}"/ssh-session.sh

# expose the ssh layer binaries (scp for legacy `scp -O`) to session shells;
# launch layers don't get their bin dir on PATH automatically in CNB
env_dir="${ssh_layer_dir}/env.launch"
mkdir -p "${env_dir}"
printf "%s" ":" >"${env_dir}/PATH.delim"
printf "%s" "${ssh_bin_dir}" >"${env_dir}/PATH.prepend"

cat >"${ssh_www_dir}/index.html" <<EOL
<!DOCTYPE html>
<html>
  <head><title>Renku SSH session</title></head>
  <body>
    <h1>Renku SSH session</h1>
    <p>This session is reachable over SSH on port 2222.</p>
  </body>
</html>
EOL

# Write layer metadata (CNB requirement)
cat >"${layers_dir}/ssh.toml" <<EOL
[types]
launch = true

[metadata]
description = "SSH frontend for renku"
version = "0.10.0"
EOL

# SET DEFAULT START COMMAND
cat >"${layers_dir}/launch.toml" <<EOL
[[processes]]
type = "ssh"
command = ["tini", "-g", "--"]
args = ["bash", "${ssh_bin_dir}/ssh-entrypoint.sh"]
default = true
EOL
