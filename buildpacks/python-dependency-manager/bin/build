#!/usr/bin/env bash
set -euo pipefail

echo -e "=== 🔧 \033[1mRenku Python dependency manager buildpack\033[0m ==="

layer_dir="${CNB_LAYERS_DIR}/deps"
execd_dir="${layer_dir}/exec.d"
env_dir="${layer_dir}/env"
mkdir -p "${execd_dir}" "${env_dir}"

buildpack_dir="${CNB_BUILDPACK_DIR}"

seed_cache() {
    mkdir -p "$1"
    [ -d "$2" ] || return 0
    cp -r "$2/." "$1"
    find "$1" -type d -exec chmod go+w {} +
}

if command -v pixi >/dev/null 2>&1; then
    pixi_cache_dir="${CNB_LAYERS_DIR}/pixi_cache"
    seed_cache "$pixi_cache_dir" "/layers/paketo-buildpacks_python-package-managers-run/pixi-env-cache"

    pixi_project_name=""
    if [ -f pixi.toml ]; then
        pixi_project_name="$(grep -m1 '^name = ' pixi.toml | sed 's/^name = "\(.*\)"$/\1/')"
    elif [ -f pyproject.toml ] && grep -q '\[tool\.pixi' pyproject.toml; then
        pixi_project_name="$(grep -m1 '^name = ' pyproject.toml | sed 's/^name = "\(.*\)"$/\1/')"
    fi
    printf '%s' "${pixi_project_name}" >"${env_dir}/RENKU_PIXI_PROJECT_NAME.override"
    printf '%s' "${pixi_cache_dir}" >"${env_dir}/RENKU_PIXI_CACHE_DIR.override"

    cp "${buildpack_dir}/bin/pixi-setup.sh" "${execd_dir}/setup.sh"

    cat >"${pixi_cache_dir}.toml"<<EOL
[types]
launch = true

[metadata]
description = "set pixi cache for in session use"
version = "0.0.6"
EOL
else
    cp "${buildpack_dir}/bin/venv-setup.sh" "${execd_dir}/setup.sh"

    if command -v uv >/dev/null 2>&1; then
        uv_cache_dir="${CNB_LAYERS_DIR}/uv_cache"
        seed_cache "$uv_cache_dir" "/layers/paketo-buildpacks_python-package-managers-run/uv-env-cache"

        printf '%s' "${uv_cache_dir}" >"${env_dir}/RENKU_UV_CACHE_DIR.override"

        cat >"${uv_cache_dir}.toml"<<EOL
[types]
launch = true

[metadata]
description = "set uv cache for in session use"
version = "0.0.6"
EOL
    fi
fi

chmod +x "${execd_dir}/setup.sh"

echo "Added launch script to ${execd_dir}/setup.sh"

cat >"${layer_dir}.toml" <<EOL
[types]
launch = true

[metadata]
description = "set dependency management for run sessions"
version = "0.0.6"
EOL
